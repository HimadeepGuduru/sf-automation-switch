<script>
// ═══════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════
const STORE_KEY = 'sfas_v2';
let S = {
  org: null,       // { instanceUrl, accessToken, name }
  automations: [], // full list from API
  snapshot: null,  // { ts, map: {id: active} }
  filter: 'all',
  search: '',
};

function loadStore() {
  try { const d = localStorage.getItem(STORE_KEY); if(d) { const p = JSON.parse(d); S.org = p.org||null; S.snapshot = p.snapshot||null; } } catch(e){}
}
function saveStore() {
  try { localStorage.setItem(STORE_KEY, JSON.stringify({ org: S.org, snapshot: S.snapshot })); } catch(e){}
}
loadStore();

// ═══════════════════════════════════════════════════════════════
// LOG
// ═══════════════════════════════════════════════════════════════
let logOpen = false, logCount = 0;
function log(msg, type='info') {
  logCount++;
  document.getElementById('logCount').textContent = logCount + ' event' + (logCount!==1?'s':'');
  const body = document.getElementById('logBody');
  const ts = new Date().toTimeString().slice(0,8);
  const el = document.createElement('div');
  el.className = 'log-entry';
  el.innerHTML = `<span class="log-ts">${ts}</span><span class="log-${type}">${msg}</span>`;
  body.insertBefore(el, body.firstChild);
  if (body.children.length > 100) body.removeChild(body.lastChild);
}
function toggleLog() {
  logOpen = !logOpen;
  document.getElementById('logBody').classList.toggle('open', logOpen);
}

// ═══════════════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════════════
function toast(msg, type='ok', duration=3000) {
  const c = document.getElementById('toastContainer');
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  const icon = type==='ok'?'✓':type==='err'?'✕':'⚠';
  el.innerHTML = `<span>${icon}</span><span>${msg}</span>`;
  c.appendChild(el);
  setTimeout(() => { el.style.opacity='0'; el.style.transform='translateX(20px)'; el.style.transition='all 0.3s'; setTimeout(()=>el.remove(),300); }, duration);
}

// ═══════════════════════════════════════════════════════════════
// MODAL
// ═══════════════════════════════════════════════════════════════
function showSetupModal()  { document.getElementById('callbackUrlDisplay').textContent = window.location.href.split('?')[0].split('#')[0]; document.getElementById('setupModal').classList.remove('hidden'); }
function showManualModal() { document.getElementById('manualModal').classList.remove('hidden'); }
function closeModal(id)    { document.getElementById(id).classList.add('hidden'); }
document.querySelectorAll('.modal-backdrop').forEach(b => b.addEventListener('click', e => { if(e.target===b) b.classList.add('hidden'); }));

function confirm2(title, msg, onOk) {
  document.getElementById('confirmTitle').textContent = title;
  document.getElementById('confirmMsg').textContent = msg;
  document.getElementById('confirmProgress').classList.add('hidden');
  document.getElementById('confirmActions').classList.remove('hidden');
  const btn = document.getElementById('confirmOkBtn');
  btn.onclick = () => { onOk(); };
  document.getElementById('confirmModal').classList.remove('hidden');
}

// ═══════════════════════════════════════════════════════════════
// OAUTH
// ═══════════════════════════════════════════════════════════════
function startOAuth() {
  const clientId = document.getElementById('clientId').value.trim();
  const env      = document.getElementById('loginEnv').value;
  const nick     = document.getElementById('orgNick').value.trim();
  if (!clientId) { toast('Please enter your Connected App Client ID', 'err'); return; }
  const cb = encodeURIComponent(window.location.href.split('?')[0].split('#')[0]);
  const state = encodeURIComponent(JSON.stringify({ nick: nick || 'My Org', clientId }));
  const url = `${env}/services/oauth2/authorize?response_type=token&client_id=${clientId}&redirect_uri=${cb}&state=${state}&prompt=login`;
  log('opening Salesforce OAuth…', 'info');
  const popup = window.open(url, 'sfauth', 'width=640,height=720,resizable=yes');
  if (!popup) {
    toast('Popup blocked — please use "paste access token" instead', 'warn');
    showManualModal();
    return;
  }
  const poll = setInterval(() => {
    try {
      if (!popup || popup.closed) { clearInterval(poll); return; }
      const h = popup.location.href;
      if (h && h.includes('access_token')) {
        clearInterval(poll); popup.close();
        handleOAuthResponse(h);
      }
    } catch(ex) { /* cross-origin */ }
  }, 400);
}

function handleOAuthResponse(url) {
  const hash = (url.includes('#') ? url.split('#')[1] : url.split('?')[1]) || '';
  const p = Object.fromEntries(hash.split('&').map(x => x.split('=')));
  const token       = decodeURIComponent(p.access_token || '');
  const instanceUrl = decodeURIComponent(p.instance_url || '');
  let stateObj = {};
  try { stateObj = JSON.parse(decodeURIComponent(p.state||'{}')); } catch(e){}
  if (!token || !instanceUrl) { toast('OAuth failed — missing token', 'err'); return; }
  S.org = { accessToken: token, instanceUrl, name: stateObj.nick || instanceUrl };
  saveStore();
  log(`✓ connected: ${instanceUrl}`, 'ok');
  toast('Connected!', 'ok');
  showDashboard();
}

function connectManual() {
  const instanceUrl = document.getElementById('manualInstance').value.trim().replace(/\/$/,'');
  const accessToken = document.getElementById('manualToken').value.trim();
  const nick        = document.getElementById('manualNick').value.trim();
  if (!instanceUrl || !accessToken) { toast('Instance URL and token are required', 'err'); return; }
  S.org = { instanceUrl, accessToken, name: nick || instanceUrl };
  saveStore();
  closeModal('manualModal');
  log('manually connected', 'ok');
  toast('Connected!', 'ok');
  showDashboard();
}

// Handle redirect back into page (hash fragment)
(function checkRedirect() {
  if (window.location.hash && window.location.hash.includes('access_token')) {
    handleOAuthResponse(window.location.href);
    history.replaceState(null,'', window.location.pathname);
  }
})();

// ═══════════════════════════════════════════════════════════════
// SHOW / HIDE VIEWS
// ═══════════════════════════════════════════════════════════════
function showDashboard() {
  document.getElementById('landing').classList.add('hidden');
  document.getElementById('dashboard').classList.remove('hidden');
  document.getElementById('orgNameDisplay').textContent = S.org.name;
  document.getElementById('orgUrlDisplay').textContent  = S.org.instanceUrl;
  renderSnapBanner();
  loadAutomations();
}

function disconnectOrg() {
  S.org = null; S.automations = []; S.snapshot = null;
  saveStore();
  document.getElementById('dashboard').classList.add('hidden');
  document.getElementById('landing').classList.remove('hidden');
  log('disconnected', 'info');
}

// ═══════════════════════════════════════════════════════════════
// SALESFORCE API HELPERS
// ═══════════════════════════════════════════════════════════════
async function sfGet(path) {
  const r = await fetch(`${S.org.instanceUrl}${path}`, {
    headers: { 'Authorization': `Bearer ${S.org.accessToken}`, 'Content-Type': 'application/json' }
  });
  if (!r.ok) {
    const txt = await r.text();
    throw new Error(`${r.status}: ${txt.slice(0,120)}`);
  }
  return r.json();
}

async function sfPost(path, body) {
  const r = await fetch(`${S.org.instanceUrl}${path}`, {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${S.org.accessToken}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  const txt = await r.text();
  try { return JSON.parse(txt); } catch(e) { return txt; }
}

async function sfPatch(path, body) {
  const r = await fetch(`${S.org.instanceUrl}${path}`, {
    method: 'PATCH',
    headers: { 'Authorization': `Bearer ${S.org.accessToken}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  if (r.status === 204) return true;
  const txt = await r.text();
  try { return JSON.parse(txt); } catch(e) { return txt; }
}

// ═══════════════════════════════════════════════════════════════
// LOAD AUTOMATIONS
// ═══════════════════════════════════════════════════════════════
async function loadAutomations() {
  document.getElementById('btnRefresh').innerHTML = '<span class="spinner"></span> Loading…';
  document.getElementById('groupsContainer').innerHTML = renderSkeletons();
  S.automations = [];

  try {
    const [vrs, flows, triggers, workflows] = await Promise.allSettled([
      fetchValidationRules(),
      fetchFlows(),
      fetchApexTriggers(),
      fetchWorkflowRules(),
    ]);

    const collect = (r, label) => {
      if (r.status === 'fulfilled') return r.value;
      log(`⚠ ${label}: ${r.reason.message}`, 'warn');
      return [];
    };

    S.automations = [
      ...collect(vrs,      'Validation Rules'),
      ...collect(flows,    'Flows'),
      ...collect(triggers, 'Apex Triggers'),
      ...collect(workflows,'Workflow Rules'),
    ];

    log(`✓ loaded ${S.automations.length} automations`, 'ok');
    toast(`Loaded ${S.automations.length} automations`, 'ok');
    updateStats();
    renderGroups();
  } catch(err) {
    log(`error loading: ${err.message}`, 'err');
    toast('Failed to load automations', 'err');
    document.getElementById('groupsContainer').innerHTML = `<div class="empty-state"><div class="icon">⚠️</div><h4>Could not load automations</h4><p>${err.message}</p></div>`;
  }

  document.getElementById('btnRefresh').innerHTML = '↻ Refresh';
}

async function fetchValidationRules() {
  const data = await sfGet(`/services/data/v59.0/tooling/query?q=${encodeURIComponent("SELECT Id, ValidationName, Active, EntityDefinition.QualifiedApiName, Description FROM ValidationRule ORDER BY EntityDefinition.QualifiedApiName, ValidationName LIMIT 2000")}`);
  return (data.records || []).map(r => ({
    id: r.Id, name: r.ValidationName, active: r.Active,
    object: r.EntityDefinition?.QualifiedApiName || 'Unknown',
    type: 'Validation Rule', typeBadge: 'badge-vr', typeCode: 'VR',
    description: r.Description || '',
    apiToggle: 'tooling',
  }));
}

async function fetchFlows() {
  // FlowDefinition gives active version status
  const data = await sfGet(`/services/data/v59.0/tooling/query?q=${encodeURIComponent("SELECT Id, DeveloperName, ActiveVersion.Id, ActiveVersion.ProcessType, LatestVersion.ProcessType, LatestVersion.TriggerObjectOrEventLabel FROM FlowDefinition ORDER BY DeveloperName LIMIT 2000")}`);
  return (data.records || []).map(r => {
    const isActive = !!r.ActiveVersion;
    const procType = r.ActiveVersion?.ProcessType || r.LatestVersion?.ProcessType || '';
    const objName  = r.LatestVersion?.TriggerObjectOrEventLabel || 'No object';
    let typeCode = 'FL', badge = 'badge-fl';
    if (procType === 'Workflow') { typeCode = 'PB'; badge = 'badge-pb'; }
    return {
      id: r.Id, name: r.DeveloperName, active: isActive,
      object: objName,
      type: typeCode === 'PB' ? 'Process Builder' : 'Flow',
      typeBadge: badge, typeCode,
      description: procType,
      apiToggle: 'flow',
      activeVersionId: r.ActiveVersion?.Id || null,
    };
  });
}

async function fetchApexTriggers() {
  const data = await sfGet(`/services/data/v59.0/tooling/query?q=${encodeURIComponent("SELECT Id, Name, Status, TableEnumOrId FROM ApexTrigger ORDER BY TableEnumOrId, Name LIMIT 2000")}`);
  return (data.records || []).map(r => ({
    id: r.Id, name: r.Name,
    active: r.Status === 'Active',
    object: r.TableEnumOrId || 'Unknown',
    type: 'Apex Trigger', typeBadge: 'badge-tr', typeCode: 'TR',
    description: `Status: ${r.Status}`,
    apiToggle: 'metadata',
  }));
}

async function fetchWorkflowRules() {
  const data = await sfGet(`/services/data/v59.0/tooling/query?q=${encodeURIComponent("SELECT Id, Name, Active, TableEnumOrId FROM WorkflowRule ORDER BY TableEnumOrId, Name LIMIT 2000")}`);
  return (data.records || []).map(r => ({
    id: r.Id, name: r.Name, active: r.Active,
    object: r.TableEnumOrId || 'Unknown',
    type: 'Workflow Rule', typeBadge: 'badge-wf', typeCode: 'WF',
    description: '',
    apiToggle: 'tooling',
  }));
}

// ═══════════════════════════════════════════════════════════════
// TOGGLE SINGLE AUTOMATION
// ═══════════════════════════════════════════════════════════════
async function toggleAutomation(id, newActive) {
  const a = S.automations.find(x => x.id === id);
  if (!a) return;
  const toggleEl = document.querySelector(`[data-toggle-id="${id}"]`);
  if (toggleEl) toggleEl.classList.add('loading');

  log(`${newActive ? 'enabling' : 'disabling'} ${a.name}…`, 'info');
  try {
    await doToggle(a, newActive);
    a.active = newActive;
    saveStore();
    log(`✓ ${a.name} → ${newActive ? 'active' : 'inactive'}`, 'ok');
    toast(`${a.name}: ${newActive ? 'enabled' : 'disabled'}`, 'ok', 2000);
    updateStats();
    updateRowState(id, newActive);
  } catch(err) {
    log(`✗ ${a.name}: ${err.message}`, 'err');
    toast(`Failed: ${err.message.slice(0,60)}`, 'err');
    // revert checkbox
    const cb = document.querySelector(`input[data-cb-id="${id}"]`);
    if (cb) cb.checked = a.active;
  }
  if (toggleEl) toggleEl.classList.remove('loading');
}

async function doToggle(a, newActive) {
  if (a.apiToggle === 'tooling') {
    // Validation Rules & Workflow Rules — direct Tooling API PATCH
    const type = a.type === 'Validation Rule' ? 'ValidationRule' : 'WorkflowRule';
    await sfPatch(`/services/data/v59.0/tooling/sobjects/${type}/${a.id}`, { Active: newActive, Metadata: { active: newActive } });
  } else if (a.apiToggle === 'flow') {
    // Flows — activate = POST new active version, deactivate = clear active version
    if (newActive) {
      // Reactivate: set active version via FlowDefinition update
      await sfPatch(`/services/data/v59.0/tooling/sobjects/FlowDefinition/${a.id}`, { ActiveVersion: { Id: a.activeVersionId } });
    } else {
      await sfPatch(`/services/data/v59.0/tooling/sobjects/FlowDefinition/${a.id}`, { ActiveVersion: null });
    }
  } else if (a.apiToggle === 'metadata') {
    // Apex Triggers — Metadata API deploy
    await deployTriggerStatus(a.name, a.object, newActive);
  }
}

async function deployTriggerStatus(name, obj, active) {
  // Use Tooling API to update trigger status directly
  const data = await sfGet(`/services/data/v59.0/tooling/query?q=${encodeURIComponent(`SELECT Id, Status, Body FROM ApexTrigger WHERE Name = '${name}' LIMIT 1`)}`);
  if (!data.records || !data.records.length) throw new Error('Trigger not found');
  const rec = data.records[0];
  await sfPatch(`/services/data/v59.0/tooling/sobjects/ApexTrigger/${rec.Id}`, {
    Status: active ? 'Active' : 'Inactive',
    Body: rec.Body,
  });
}

// ═══════════════════════════════════════════════════════════════
// BULK OPERATIONS
// ═══════════════════════════════════════════════════════════════
async function disableAll() {
  const active = S.automations.filter(a => a.active);
  if (!active.length) { toast('All automations already inactive', 'warn'); return; }
  confirm2(
    '🔴 Disable all automations',
    `This will deactivate ${active.length} active automations. A snapshot will be saved first so you can revert exactly.`,
    async () => {
      // Take snapshot before touching anything (only if no snapshot exists)
      if (!S.snapshot) {
        S.snapshot = { ts: Date.now(), map: {} };
        S.automations.forEach(a => S.snapshot.map[a.id] = a.active);
        saveStore();
        log('📸 snapshot taken', 'warn');
      }
      await bulkToggle(S.automations.filter(a => a.active), false, 'Disabling');
    }
  );
}

async function enableAll() {
  const inactive = S.automations.filter(a => !a.active);
  if (!inactive.length) { toast('All automations already active', 'ok'); return; }
  confirm2(
    '🟢 Enable all automations',
    `This will activate ${inactive.length} inactive automations.`,
    async () => { await bulkToggle(S.automations.filter(a => !a.active), true, 'Enabling'); }
  );
}

async function revertSnapshot() {
  if (!S.snapshot) return;
  confirm2(
    '↩ Revert to snapshot',
    `Restore all automations to their exact state at ${new Date(S.snapshot.ts).toLocaleString()}. This is your pre-migration baseline.`,
    async () => {
      const toChange = S.automations.filter(a => S.snapshot.map[a.id] !== undefined && S.snapshot.map[a.id] !== a.active);
      if (!toChange.length) { toast('Already matches snapshot', 'ok'); closeModal('confirmModal'); clearSnapshot(); return; }
      await bulkToggle(toChange, null, 'Reverting', true);
      clearSnapshot();
    }
  );
}

async function bulkToggle(items, newActive, label, useSnapshot=false) {
  closeModal('confirmModal');
  document.getElementById('confirmModal').classList.remove('hidden');
  document.getElementById('confirmActions').classList.add('hidden');
  document.getElementById('confirmProgress').classList.remove('hidden');
  document.getElementById('confirmTitle').textContent = `${label}…`;
  document.getElementById('confirmMsg').textContent = `Processing ${items.length} automations. Please wait.`;

  let done = 0;
  const errors = [];

  for (const a of items) {
    const target = useSnapshot ? S.snapshot.map[a.id] : newActive;
    document.getElementById('progressFill').style.width = `${Math.round((done/items.length)*100)}%`;
    document.getElementById('progressLabel').textContent = `${done}/${items.length} — ${a.name}`;
    try {
      await doToggle(a, target);
      a.active = target;
      updateRowState(a.id, target);
    } catch(err) {
      errors.push(a.name);
      log(`✗ ${a.name}: ${err.message.slice(0,60)}`, 'err');
    }
    done++;
    await sleep(120); // rate limiting
  }

  document.getElementById('progressFill').style.width = '100%';
  document.getElementById('progressLabel').textContent = `Done — ${done - errors.length}/${items.length} succeeded`;
  updateStats();
  saveStore();
  renderSnapBanner();

  if (errors.length) {
    log(`bulk complete — ${errors.length} error(s): ${errors.join(', ')}`, 'warn');
    toast(`Done with ${errors.length} error(s)`, 'warn');
  } else {
    log(`✓ bulk ${label.toLowerCase()} complete`, 'ok');
    toast(`${label} complete!`, 'ok');
  }

  setTimeout(() => closeModal('confirmModal'), 1200);
}

function clearSnapshot() {
  S.snapshot = null;
  saveStore();
  renderSnapBanner();
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

// ═══════════════════════════════════════════════════════════════
// GROUP BULK TOGGLE
// ═══════════════════════════════════════════════════════════════
async function bulkToggleGroup(obj, type, newActive) {
  const items = S.automations.filter(a => a.object === obj && a.type === type && a.active !== newActive);
  if (!items.length) return;
  log(`${newActive?'enabling':'disabling'} ${items.length} ${type}s on ${obj}…`, 'info');
  for (const a of items) {
    try { await doToggle(a, newActive); a.active = newActive; updateRowState(a.id, newActive); } catch(e) { log(`✗ ${a.name}: ${e.message}`, 'err'); }
    await sleep(100);
  }
  updateStats(); saveStore();
  toast(`${items.length} ${type}(s) on ${obj}: ${newActive?'enabled':'disabled'}`, 'ok', 2000);
}

// ═══════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════
function updateStats() {
  const all    = S.automations;
  const active = all.filter(a => a.active).length;
  const objs   = new Set(all.map(a => a.object)).size;
  document.getElementById('statTotal').textContent    = all.length;
  document.getElementById('statActive').textContent   = active;
  document.getElementById('statInactive').textContent = all.length - active;
  document.getElementById('statObjects').textContent  = objs;
}

function setFilter(f, btn) {
  S.filter = f;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b === btn));
  applyFilters();
}

function applyFilters() {
  S.search = document.getElementById('searchInput').value.toLowerCase();
  renderGroups();
}

function getFiltered() {
  return S.automations.filter(a => {
    if (S.filter === 'active'   && !a.active)  return false;
    if (S.filter === 'inactive' &&  a.active)  return false;
    if (S.search && !a.name.toLowerCase().includes(S.search) && !a.object.toLowerCase().includes(S.search)) return false;
    return true;
  });
}

function renderGroups() {
  const filtered = getFiltered();
  const container = document.getElementById('groupsContainer');

  if (!filtered.length) {
    container.innerHTML = `<div class="empty-state"><div class="icon">🔍</div><h4>No results</h4><p>Try adjusting your search or filter.</p></div>`;
    return;
  }

  // Group by object, then by type
  const byObject = {};
  filtered.forEach(a => {
    if (!byObject[a.object]) byObject[a.object] = {};
    if (!byObject[a.object][a.type]) byObject[a.object][a.type] = [];
    byObject[a.object][a.type].push(a);
  });

  const objects = Object.keys(byObject).sort();
  container.innerHTML = objects.map(obj => {
    const types = Object.keys(byObject[obj]).sort();
    const allA  = Object.values(byObject[obj]).flat();
    const activeN = allA.filter(a=>a.active).length;

    const rowsHtml = types.map(type => {
      const items = byObject[obj][type];
      const typeActiveN = items.filter(a=>a.active).length;
      const subHeader = `
        <div style="display:flex;align-items:center;gap:8px;padding:8px 18px 4px;border-top:1px solid var(--border)">
          <span class="auto-type-badge ${items[0].typeBadge}">${items[0].typeCode}</span>
          <span style="font-size:12px;color:var(--text2);font-weight:500">${type}</span>
          <span class="status-pill ${typeActiveN===items.length?'pill-green':typeActiveN===0?'pill-red':'pill-amber'}" style="font-size:10px;padding:2px 8px">${typeActiveN}/${items.length} active</span>
          <div style="flex:1"></div>
          <button class="btn btn-ghost" style="font-size:10px;padding:4px 8px" onclick="bulkToggleGroup('${esc(obj)}','${esc(type)}',true)">all on</button>
          <button class="btn btn-ghost" style="font-size:10px;padding:4px 8px" onclick="bulkToggleGroup('${esc(obj)}','${esc(type)}',false)">all off</button>
        </div>`;
      const rowsStr = items.map(a => renderAutoRow(a)).join('');
      return subHeader + rowsStr;
    }).join('');

    return `
      <div class="object-group">
        <div class="group-header" onclick="toggleGroup(this)">
          <span class="group-chevron">▾</span>
          <span class="group-title">${obj}</span>
          <span class="group-count">${allA.length} automation${allA.length!==1?'s':''}</span>
          <span class="status-pill ${activeN===allA.length?'pill-green':activeN===0?'pill-red':'pill-amber'}" style="font-size:10px">${activeN}/${allA.length} active</span>
          <div class="group-line"></div>
        </div>
        <div class="group-body">
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden">
            ${rowsHtml}
          </div>
        </div>
      </div>`;
  }).join('');
}

function renderAutoRow(a) {
  const snapWas = S.snapshot ? S.snapshot.map[a.id] : undefined;
  const snapBadge = snapWas !== undefined
    ? `<span class="snap-indicator ${snapWas ? 'snap-was-on' : 'snap-was-off'}">${snapWas ? '● was on' : '○ was off'}</span>`
    : '';
  return `
    <div class="auto-row ${a.active ? 'active' : 'inactive'}" id="row-${a.id}">
      <div class="auto-name">
        <div class="auto-name-text">${esc(a.name)}</div>
        ${a.description ? `<div class="auto-meta">${esc(a.description)}</div>` : ''}
      </div>
      ${snapBadge}
      <span class="auto-api-tag">${a.typeCode}</span>
      <label class="toggle" data-toggle-id="${a.id}" aria-label="Toggle ${esc(a.name)}">
        <input type="checkbox" data-cb-id="${a.id}" ${a.active?'checked':''} onchange="toggleAutomation('${a.id}', this.checked)">
        <span class="tslider"></span>
      </label>
    </div>`;
}

function updateRowState(id, active) {
  const row = document.getElementById(`row-${id}`);
  if (!row) return;
  row.className = `auto-row ${active ? 'active' : 'inactive'}`;
  const cb = row.querySelector(`input[data-cb-id="${id}"]`);
  if (cb) cb.checked = active;
}

function toggleGroup(header) {
  header.classList.toggle('collapsed');
  const body = header.nextElementSibling;
  if (body) body.style.display = header.classList.contains('collapsed') ? 'none' : '';
}

function renderSnapBanner() {
  const banner = document.getElementById('snapBanner');
  if (!S.snapshot) { banner.classList.add('hidden'); return; }
  banner.classList.remove('hidden');
  document.getElementById('snapTs').textContent = new Date(S.snapshot.ts).toLocaleString();
}

function renderSkeletons() {
  return Array(6).fill(0).map(() => `
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;margin-bottom:8px;display:flex;gap:12px;align-items:center">
      <div class="skeleton" style="width:60px"></div>
      <div style="flex:1"><div class="skeleton" style="width:60%;margin-bottom:6px"></div><div class="skeleton" style="width:30%"></div></div>
      <div class="skeleton" style="width:42px;height:23px;border-radius:12px"></div>
    </div>`).join('');
}

function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ═══════════════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════════════
if (S.org && S.org.accessToken) {
  showDashboard();
} else {
  document.getElementById('landing').classList.remove('hidden');
}
</script>
