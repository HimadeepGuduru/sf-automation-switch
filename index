<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SF Automation Switch</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Geist:wght@300;400;500&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════════════════════
   DESIGN SYSTEM — dark industrial / control-room aesthetic
   Primary: slate-900 bg, amber accent, monospace data labels
═══════════════════════════════════════════════════════════════ */
:root {
  --bg:       #0a0c0f;
  --surface:  #111418;
  --surface2: #181d24;
  --surface3: #1e252f;
  --border:   rgba(255,255,255,0.06);
  --border2:  rgba(255,255,255,0.11);
  --text:     #d4d8de;
  --text2:    #8b95a1;
  --text3:    #515c68;
  --amber:    #f59e0b;
  --amber2:   rgba(245,158,11,0.15);
  --amber3:   rgba(245,158,11,0.08);
  --green:    #10b981;
  --green2:   rgba(16,185,129,0.12);
  --red:      #f43f5e;
  --red2:     rgba(244,63,94,0.12);
  --blue:     #3b82f6;
  --blue2:    rgba(59,130,246,0.12);
  --mono:     'JetBrains Mono', monospace;
  --display:  'Syne', sans-serif;
  --body:     'Geist', sans-serif;
  --radius:   10px;
  --radius-lg:16px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: var(--body);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── NOISE OVERLAY ── */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none; z-index: 0; opacity: 0.4;
}

/* ── TOPBAR ── */
.topbar {
  position: sticky; top: 0; z-index: 200;
  background: rgba(10,12,15,0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 0 28px;
  height: 56px;
  display: flex; align-items: center; justify-content: space-between;
}
.logo {
  display: flex; align-items: center; gap: 12px;
  font-family: var(--display);
}
.logo-mark {
  width: 32px; height: 32px;
  background: var(--amber);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
  box-shadow: 0 0 20px rgba(245,158,11,0.3);
}
.logo-name { font-size: 15px; font-weight: 600; color: var(--text); letter-spacing: -0.3px; }
.logo-ver  { font-size: 10px; font-family: var(--mono); color: var(--text3); margin-left: 4px; }

.topbar-right { display: flex; align-items: center; gap: 8px; }

/* ── LAYOUT ── */
.app { position: relative; z-index: 1; }

/* ── LANDING (connect screen) ── */
.landing {
  min-height: calc(100vh - 56px);
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
  padding: 40px 24px;
  text-align: center;
}
.landing-title {
  font-family: var(--display);
  font-size: clamp(28px, 5vw, 48px);
  font-weight: 700;
  letter-spacing: -1px;
  line-height: 1.1;
  margin-bottom: 16px;
  background: linear-gradient(135deg, var(--text) 40%, var(--amber) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.landing-sub {
  font-size: 15px; color: var(--text2); max-width: 480px;
  line-height: 1.7; margin-bottom: 48px;
}
.connect-box {
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: var(--radius-lg);
  padding: 32px;
  width: 100%; max-width: 440px;
  text-align: left;
}
.connect-box h3 {
  font-family: var(--display); font-size: 16px; font-weight: 600;
  margin-bottom: 6px;
}
.connect-box p { font-size: 13px; color: var(--text2); margin-bottom: 24px; line-height: 1.6; }

.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.field-label {
  font-family: var(--mono); font-size: 10px; letter-spacing: 1px;
  text-transform: uppercase; color: var(--text3);
}
.field-input, .field-select {
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: var(--radius);
  padding: 10px 14px;
  color: var(--text);
  font-size: 13px; font-family: var(--body);
  outline: none; width: 100%;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.field-input:focus, .field-select:focus {
  border-color: var(--amber);
  box-shadow: 0 0 0 3px rgba(245,158,11,0.12);
}
.field-input::placeholder { color: var(--text3); }
.field-select { appearance: none; cursor: pointer; }
.field-hint { font-size: 11px; color: var(--text3); line-height: 1.5; }
.field-hint a { color: var(--amber); text-decoration: none; }
.field-hint a:hover { text-decoration: underline; }

/* ── BUTTONS ── */
.btn {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 9px 16px; border-radius: var(--radius);
  border: 1px solid var(--border2);
  background: var(--surface2);
  color: var(--text);
  font-size: 12px; font-weight: 500; font-family: var(--body);
  cursor: pointer; transition: all 0.15s; white-space: nowrap;
}
.btn:hover  { border-color: var(--border2); background: var(--surface3); }
.btn:active { transform: scale(0.97); }
.btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
.btn-amber {
  background: var(--amber); border-color: var(--amber);
  color: #0a0c0f; font-weight: 600;
  box-shadow: 0 0 16px rgba(245,158,11,0.25);
}
.btn-amber:hover { background: #fbbf24; border-color: #fbbf24; box-shadow: 0 0 24px rgba(245,158,11,0.4); }
.btn-green  { background: var(--green2); border-color: rgba(16,185,129,0.3); color: var(--green); }
.btn-green:hover { background: rgba(16,185,129,0.2); }
.btn-red    { background: var(--red2);   border-color: rgba(244,63,94,0.3);   color: var(--red); }
.btn-red:hover   { background: rgba(244,63,94,0.2); }
.btn-ghost  { background: transparent; border-color: transparent; color: var(--text2); }
.btn-ghost:hover { background: var(--surface2); color: var(--text); }
.btn-full { width: 100%; justify-content: center; padding: 11px 16px; }

/* ── MAIN DASHBOARD ── */
.dashboard { padding: 24px 28px; max-width: 1200px; margin: 0 auto; }

/* ── ORG STRIP ── */
.org-strip {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 18px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-lg); margin-bottom: 24px;
  flex-wrap: wrap;
}
.org-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); flex-shrink: 0; }
.org-name { font-family: var(--display); font-size: 14px; font-weight: 600; }
.org-url  { font-family: var(--mono); font-size: 11px; color: var(--text3); }
.org-sep  { flex: 1; }
.status-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 500;
  font-family: var(--mono);
}
.pill-green { background: var(--green2); color: var(--green); }
.pill-red   { background: var(--red2);   color: var(--red); }
.pill-amber { background: var(--amber2); color: var(--amber); }
.pill-grey  { background: var(--surface3); color: var(--text3); }

/* ── STATS ROW ── */
.stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 24px; }
.stat-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 16px 20px;
}
.stat-val { font-family: var(--display); font-size: 28px; font-weight: 700; line-height: 1; }
.stat-label { font-family: var(--mono); font-size: 10px; letter-spacing: 1px; color: var(--text3); text-transform: uppercase; margin-top: 6px; }
.stat-card.amber .stat-val { color: var(--amber); }
.stat-card.green .stat-val { color: var(--green); }
.stat-card.red   .stat-val { color: var(--red); }

/* ── TOOLBAR ── */
.toolbar {
  display: flex; align-items: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap;
}
.toolbar-left  { display: flex; gap: 8px; flex-wrap: wrap; }
.toolbar-right { display: flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }

.search-wrap { position: relative; }
.search-input {
  background: var(--surface); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 8px 12px 8px 34px;
  color: var(--text); font-size: 12px; font-family: var(--body); outline: none;
  width: 220px; transition: border-color 0.15s;
}
.search-input:focus { border-color: var(--amber); }
.search-icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 13px; color: var(--text3); pointer-events: none; }

.filter-btn { font-family: var(--mono); font-size: 11px; padding: 7px 12px; }
.filter-btn.active { background: var(--amber2); border-color: rgba(245,158,11,0.3); color: var(--amber); }

/* ── SNAPSHOT BANNER ── */
.snap-banner {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 12px 18px; margin-bottom: 20px;
  background: var(--amber3); border: 1px solid rgba(245,158,11,0.2);
  border-radius: var(--radius-lg); font-size: 12px; color: var(--amber);
  flex-wrap: wrap;
}
.snap-banner-left { display: flex; align-items: center; gap: 10px; }
.snap-ts { font-family: var(--mono); font-size: 11px; opacity: 0.7; }

/* ── OBJECT GROUP ── */
.object-group { margin-bottom: 24px; }
.group-header {
  display: flex; align-items: center; gap: 12px;
  margin-bottom: 12px; cursor: pointer; user-select: none;
}
.group-chevron { color: var(--text3); font-size: 12px; transition: transform 0.2s; }
.group-header.collapsed .group-chevron { transform: rotate(-90deg); }
.group-title { font-family: var(--display); font-size: 13px; font-weight: 600; }
.group-obj   { font-family: var(--mono); font-size: 11px; color: var(--text3); }
.group-count { font-family: var(--mono); font-size: 10px; color: var(--text3); background: var(--surface2); padding: 2px 8px; border-radius: 10px; }
.group-line  { flex: 1; height: 1px; background: var(--border); }
.group-bulk  { display: flex; gap: 6px; }

.group-body { display: flex; flex-direction: column; gap: 1px; }

/* ── AUTOMATION ROW ── */
.auto-row {
  display: flex; align-items: center; gap: 14px;
  padding: 12px 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: background 0.12s, border-color 0.12s;
  position: relative; overflow: hidden;
}
.auto-row::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  border-radius: 3px 0 0 3px;
  transition: background 0.2s;
}
.auto-row.active::before   { background: var(--green); }
.auto-row.inactive::before { background: var(--red); }
.auto-row:hover { background: var(--surface2); border-color: var(--border2); }

.auto-type-badge {
  font-family: var(--mono); font-size: 10px; letter-spacing: 0.5px;
  padding: 3px 8px; border-radius: 6px; flex-shrink: 0;
  font-weight: 500;
}
.badge-vr  { background: rgba(139,92,246,0.15); color: #a78bfa; }
.badge-fl  { background: rgba(59,130,246,0.15);  color: #60a5fa; }
.badge-tr  { background: rgba(245,158,11,0.15);  color: #fbbf24; }
.badge-wf  { background: rgba(20,184,166,0.15);  color: #2dd4bf; }
.badge-pb  { background: rgba(244,63,94,0.15);   color: #fb7185; }
.badge-ar  { background: rgba(16,185,129,0.15);  color: #34d399; }

.auto-name { font-size: 13px; font-weight: 500; flex: 1; min-width: 0; }
.auto-name-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.auto-meta { font-family: var(--mono); font-size: 10px; color: var(--text3); margin-top: 2px; }

.auto-api-tag {
  font-family: var(--mono); font-size: 10px; color: var(--text3);
  background: var(--surface3); padding: 2px 7px; border-radius: 5px; flex-shrink: 0;
}
.snap-indicator {
  font-family: var(--mono); font-size: 10px; padding: 2px 7px;
  border-radius: 5px; flex-shrink: 0;
}
.snap-was-on  { background: var(--green2); color: var(--green); }
.snap-was-off { background: var(--red2);   color: var(--red); }

/* ── TOGGLE ── */
.toggle { position: relative; width: 42px; height: 23px; flex-shrink: 0; cursor: pointer; }
.toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
.tslider {
  position: absolute; inset: 0;
  background: var(--surface3); border: 1px solid var(--border2);
  border-radius: 23px; transition: background 0.2s, border-color 0.2s;
}
.tslider::before {
  content: ''; position: absolute;
  height: 15px; width: 15px; left: 3px; bottom: 3px;
  background: var(--text3); border-radius: 50%; transition: all 0.2s;
}
input:checked ~ .tslider { background: var(--green2); border-color: rgba(16,185,129,0.4); }
input:checked ~ .tslider::before { transform: translateX(19px); background: var(--green); }
.toggle.loading .tslider::before { animation: pulse-dot 0.6s ease-in-out infinite alternate; }
@keyframes pulse-dot { from { opacity: 0.4; } to { opacity: 1; } }

/* ── LOADING STATES ── */
.spinner {
  width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.15);
  border-top-color: var(--amber); border-radius: 50%;
  animation: spin 0.7s linear infinite; display: inline-block; flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }

.skeleton {
  background: linear-gradient(90deg, var(--surface2) 25%, var(--surface3) 50%, var(--surface2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  border-radius: 6px; height: 14px;
}
@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

/* ── LOG PANEL ── */
.log-panel {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
  background: rgba(10,12,15,0.96); backdrop-filter: blur(12px);
  border-top: 1px solid var(--border); padding: 0;
  transition: height 0.2s ease;
}
.log-toggle {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 20px; cursor: pointer;
  border: none; background: transparent; width: 100%; text-align: left;
}
.log-toggle-label { font-family: var(--mono); font-size: 10px; letter-spacing: 1px; color: var(--text3); text-transform: uppercase; }
.log-live { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: blink 1.5s ease-in-out infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
.log-body {
  max-height: 0; overflow: hidden; transition: max-height 0.2s ease;
  padding: 0 20px;
}
.log-body.open { max-height: 140px; overflow-y: auto; padding: 8px 20px 12px; }
.log-entry { display: flex; gap: 12px; font-family: var(--mono); font-size: 11px; line-height: 1.8; }
.log-ts    { color: var(--text3); flex-shrink: 0; }
.log-ok    { color: var(--green); }
.log-err   { color: var(--red); }
.log-info  { color: var(--text2); }
.log-warn  { color: var(--amber); }

/* ── MODAL ── */
.modal-backdrop {
  position: fixed; inset: 0; background: rgba(0,0,0,0.75);
  display: flex; align-items: center; justify-content: center;
  z-index: 500; padding: 20px;
  animation: fade-in 0.15s ease;
}
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
.modal {
  background: var(--surface); border: 1px solid var(--border2);
  border-radius: var(--radius-lg); padding: 28px;
  width: 100%; max-width: 460px;
  animation: slide-up 0.2s ease;
}
@keyframes slide-up { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.modal h3 { font-family: var(--display); font-size: 18px; font-weight: 600; margin-bottom: 8px; }
.modal p  { font-size: 13px; color: var(--text2); line-height: 1.7; margin-bottom: 24px; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 24px; }

/* ── SETUP STEPS ── */
.steps { display: flex; flex-direction: column; gap: 12px; margin: 16px 0; }
.step { display: flex; gap: 12px; }
.step-num {
  width: 24px; height: 24px; border-radius: 50%; background: var(--amber);
  color: #0a0c0f; font-size: 11px; font-weight: 700; font-family: var(--display);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;
}
.step-content { font-size: 13px; color: var(--text2); line-height: 1.6; }
.step-content code { font-family: var(--mono); font-size: 11px; background: var(--surface3); padding: 1px 5px; border-radius: 4px; color: var(--text); }
.step-content a { color: var(--amber); }

/* ── EMPTY / ERROR ── */
.empty-state { padding: 60px 24px; text-align: center; color: var(--text2); }
.empty-state .icon { font-size: 36px; margin-bottom: 12px; opacity: 0.4; }
.empty-state h4 { font-family: var(--display); font-size: 15px; color: var(--text); margin-bottom: 6px; }
.empty-state p  { font-size: 13px; max-width: 340px; margin: 0 auto; line-height: 1.6; }

/* ── TOAST ── */
.toast-container { position: fixed; top: 70px; right: 20px; z-index: 999; display: flex; flex-direction: column; gap: 8px; }
.toast {
  background: var(--surface); border: 1px solid var(--border2);
  border-radius: var(--radius); padding: 10px 16px;
  font-size: 12px; font-weight: 500; display: flex; align-items: center; gap: 8px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  animation: toast-in 0.2s ease; min-width: 220px;
}
.toast.ok   { border-left: 3px solid var(--green); }
.toast.err  { border-left: 3px solid var(--red); }
.toast.warn { border-left: 3px solid var(--amber); }
@keyframes toast-in { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

/* ── PROGRESS BAR ── */
.progress-bar { height: 2px; background: var(--border); border-radius: 2px; overflow: hidden; margin: 8px 0; }
.progress-fill { height: 100%; background: var(--amber); border-radius: 2px; transition: width 0.3s ease; }

/* ── UTIL ── */
.hidden { display: none !important; }
.mt8 { margin-top: 8px; }
.page-pad { padding-bottom: 80px; }
</style>
</head>
<body>
<div class="app">

<!-- ═══ TOPBAR ═══ -->
<nav class="topbar">
  <div class="logo">
    <div class="logo-mark">⚡</div>
    <span class="logo-name">SF Automation Switch</span>
    <span class="logo-ver">v2.0</span>
  </div>
  <div class="topbar-right" id="topbarRight">
    <button class="btn btn-ghost" onclick="showSetupModal()" id="btnSetup">📋 Setup guide</button>
  </div>
</nav>

<!-- ═══ LANDING ═══ -->
<div id="landing" class="landing">
  <div class="landing-title">Automation<br>Control Center</div>
  <p class="landing-sub">Connect your Salesforce org to read, toggle, and snapshot every automation — grouped by object. Built for data migrations.</p>

  <div class="connect-box">
    <h3>Connect via OAuth</h3>
    <p>You'll be redirected to Salesforce to log in. Your token stays in your browser only — nothing is sent to any server.</p>

    <div class="field">
      <div class="field-label">Connected App Client ID</div>
      <input class="field-input" id="clientId" placeholder="3MVG9xOCSsuQDlO…" />
      <div class="field-hint">From Setup → App Manager → your Connected App. <a href="#" onclick="showSetupModal();return false;">Need help? See setup guide →</a></div>
    </div>

    <div class="field">
      <div class="field-label">Environment</div>
      <select class="field-select" id="loginEnv">
        <option value="https://login.salesforce.com">Production / Developer org</option>
        <option value="https://test.salesforce.com">Sandbox</option>
      </select>
    </div>

    <div class="field">
      <div class="field-label">Org nickname (optional)</div>
      <input class="field-input" id="orgNick" placeholder="e.g. CAIS Sandbox" />
    </div>

    <button class="btn btn-amber btn-full mt8" onclick="startOAuth()">
      🔐 Connect to Salesforce
    </button>

    <div style="margin-top:16px;text-align:center;font-size:12px;color:var(--text3)">
      or <a href="#" style="color:var(--amber)" onclick="showManualModal();return false;">paste access token manually</a>
    </div>
  </div>
</div>

<!-- ═══ DASHBOARD ═══ -->
<div id="dashboard" class="dashboard page-pad hidden">

  <!-- ORG STRIP -->
  <div class="org-strip">
    <div class="org-dot"></div>
    <div>
      <div class="org-name" id="orgNameDisplay">—</div>
      <div class="org-url"  id="orgUrlDisplay">—</div>
    </div>
    <div class="org-sep"></div>
    <div id="orgStatusPill" class="status-pill pill-green">● connected</div>
